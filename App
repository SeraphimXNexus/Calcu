<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Calculator</title>
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <style>
        :root {
            --primary: #ad1457;
            --accent: #f06292;
            --bg: #fce4ec;
            --surface: #ffffff;
            --text: #4a001f;
            --shadow: 0 10px 30px rgba(173, 20, 87, 0.15);
        }

        * {
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
            user-select: none;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: var(--bg);
            margin: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }

        .app-container {
            width: 100%;
            max-width: 400px;
            background: var(--surface);
            height: 100vh;
            max-height: 850px;
            border-radius: 40px;
            box-shadow: var(--shadow);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            position: relative;
            padding: 20px;
        }

        /* App Logo & Header */
        .app-header {
            display: flex;
            flex-direction: column;
            align-items: center;
            margin-top: 10px;
            margin-bottom: 20px;
        }

        .app-logo {
            width: 50px;
            height: 50px;
            background: linear-gradient(135deg, var(--primary), var(--accent));
            border-radius: 12px;
            display: flex;
            justify-content: center;
            align-items: center;
            margin-bottom: 10px;
            box-shadow: 0 4px 10px rgba(173, 20, 87, 0.3);
        }

        .app-logo svg {
            width: 30px;
            height: 30px;
            fill: white;
        }

        .app-name {
            font-weight: 800;
            font-size: 1.2rem;
            color: var(--primary);
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        /* Display Area */
        .display-unit {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            padding: 20px;
            text-align: right;
        }

        #history-display {
            font-size: 1.1rem;
            color: #f48fb1;
            margin-bottom: 5px;
            min-height: 1.2em;
            word-wrap: break-word;
        }

        #main-output {
            font-size: 3.5rem;
            font-weight: 300;
            color: var(--text);
            margin: 0;
            overflow-x: auto;
            white-space: nowrap;
        }

        /* Keypad */
        .keypad {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
            padding-bottom: 20px;
        }

        button {
            aspect-ratio: 1/1;
            border-radius: 20px;
            border: none;
            font-size: 1.5rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.1s ease;
            display: flex;
            justify-content: center;
            align-items: center;
            background: #fdf2f6;
            color: var(--primary);
        }

        button:active {
            transform: scale(0.92);
            background: #f8bbd0;
        }

        .btn-op {
            background: #fce4ec;
            color: var(--accent);
        }

        .btn-action {
            background: var(--accent);
            color: white;
        }

        .btn-equal {
            background: var(--primary);
            color: white;
            grid-column: span 2;
            aspect-ratio: auto;
        }

        .btn-clear {
            background: #eeeeee;
            color: #757575;
        }

        /* Responsive Tweaks */
        @media (max-height: 700px) {
            .app-container { border-radius: 0; max-height: 100vh; }
            button { border-radius: 15px; }
        }
    </style>
</head>
<body>

<div class="app-container">
    <div class="app-header">
        <div class="app-logo">
            <svg viewBox="0 0 24 24"><path d="M7,2V4H17V2H7M7,6V8H17V6H7M9,11V13H11V11H9M13,11V13H15V11H13M9,15V17H11V15H9M13,15V17H15V15H13M7,19V21H17V19H7Z"/></svg>
        </div>
        <div class="app-name">Calculator</div>
    </div>

    <div class="display-unit">
        <div id="history-display"></div>
        <div id="main-output">0</div>
    </div>

    <div class="keypad">
        <button class="btn-clear" onclick="allClear()">AC</button>
        <button class="btn-clear" onclick="backspace()">C</button>
        <button class="btn-op" onclick="append('%')">%</button>
        <button class="btn-action" onclick="append('/')">÷</button>

        <button onclick="append('7')">7</button>
        <button onclick="append('8')">8</button>
        <button onclick="append('9')">9</button>
        <button class="btn-action" onclick="append('*')">×</button>

        <button onclick="append('4')">4</button>
        <button onclick="append('5')">5</button>
        <button onclick="append('6')">6</button>
        <button class="btn-action" onclick="append('-')">−</button>

        <button onclick="append('1')">1</button>
        <button onclick="append('2')">2</button>
        <button onclick="append('3')">3</button>
        <button class="btn-action" onclick="append('+')">+</button>

        <button onclick="append('0')">0</button>
        <button onclick="append('.')">.</button>
        <button class="btn-equal" onclick="calculate()">=</button>
    </div>
</div>

<script>
    let currentInput = "0";
    let historyInput = "";
    const mainDisplay = document.getElementById('main-output');
    const historyDisplay = document.getElementById('history-display');

    function updateDisplay() {
        mainDisplay.innerText = currentInput;
        historyDisplay.innerText = historyInput;
        // Auto-shrink font if number is too long
        if (currentInput.length > 8) {
            mainDisplay.style.fontSize = '2rem';
        } else {
            mainDisplay.style.fontSize = '3.5rem';
        }
    }

    function append(char) {
        if (currentInput === "0" || /[a-zA-Z]/.test(currentInput)) {
            currentInput = char;
        } else {
            currentInput += char;
        }
        updateDisplay();
    }

    function allClear() {
        currentInput = "0";
        historyInput = "";
        updateDisplay();
    }

    function backspace() {
        if (currentInput.length > 1) {
            currentInput = currentInput.slice(0, -1);
        } else {
            currentInput = "0";
        }
        updateDisplay();
    }

    function calculate() {
        // Special Messages
        if (currentInput === "1+1") {
            currentInput = "miss na kita";
            updateDisplay();
            return;
        }
        if (currentInput === "5+5") {
            currentInput = "balik kana please";
            updateDisplay();
            return;
        }

        try {
            historyInput = currentInput + " =";
            // Replace visual symbols for actual math
            let expression = currentInput.replace(/×/g, '*').replace(/÷/g, '/');
            let result = eval(expression);
            
            // Format result
            if (Number.isInteger(result)) {
                currentInput = result.toString();
            } else {
                currentInput = parseFloat(result.toFixed(8)).toString();
            }
        } catch (e) {
            currentInput = "Error";
        }
        updateDisplay();
    }

    // Keyboard support
    document.addEventListener('keydown', (e) => {
        if (e.key >= 0 && e.key <= 9) append(e.key);
        if (e.key === '+') append('+');
        if (e.key === '-') append('-');
        if (e.key === '*') append('*');
        if (e.key === '/') append('/');
        if (e.key === 'Enter' || e.key === '=') calculate();
        if (e.key === 'Backspace') backspace();
        if (e.key === 'Escape') allClear();
    });
</script>

</body>
</html>
